{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openhuntdata.org/schemas/1.0/sighting.schema.json",
  "title": "Open Hunt Data sightings.json",
  "type": "array",
  "items": { "$ref": "#/$defs/sighting" },
  "$defs": {
    "observation": {
      "type": "object",
      "required": ["species"],
      "properties": {
        "species": { "type": "string", "minLength": 1 },
        "species_text": { "type": "string" },
        "count": { "type": "integer", "minimum": 1, "default": 1 },
        "sex": { "type": "string" },
        "age_class": { "type": "string" },
        "attributes": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
      }
    },
    "sighting": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/envelope" },
        {
          "type": "object",
          "required": ["occurred_at", "source_kind", "observations"],
          "properties": {
            "occurred_at": { "$ref": "common.schema.json#/$defs/dateOrTimestamp" },
            "location": { "$ref": "common.schema.json#/$defs/nullablePoint" },
            "source_kind": { "enum": ["in_person", "trail_camera", "other"] },
            "observations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/observation" } },
            "hunt_id": { "$ref": "common.schema.json#/$defs/uuid" },
            "waypoint_id": { "$ref": "common.schema.json#/$defs/uuid" },
            "area_id": { "$ref": "common.schema.json#/$defs/uuid" },
            "property_id": { "$ref": "common.schema.json#/$defs/uuid" },
            "weather": { "$ref": "common.schema.json#/$defs/weather" }
          }
        }
      ]
    }
  }
}
