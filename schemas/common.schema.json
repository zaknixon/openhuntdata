{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openhuntdata.org/schemas/1.0/common.schema.json",
  "title": "Open Hunt Data common definitions",
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "date": { "type": "string", "format": "date" },
    "dateOrTimestamp": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "$ref": "#/$defs/date" }] },
    "position": {
      "type": "array", "minItems": 2, "maxItems": 3,
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 },
        { "type": "number" }
      ],
      "items": false
    },
    "linearRing": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/position" } },
    "point": {
      "type": "object", "required": ["type", "coordinates"],
      "properties": { "type": { "const": "Point" }, "coordinates": { "$ref": "#/$defs/position" } }
    },
    "nullablePoint": { "anyOf": [{ "$ref": "#/$defs/point" }, { "type": "null" }] },
    "lineString": {
      "type": "object", "required": ["type", "coordinates"],
      "properties": { "type": { "const": "LineString" }, "coordinates": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/position" } } }
    },
    "multiLineString": {
      "type": "object", "required": ["type", "coordinates"],
      "properties": { "type": { "const": "MultiLineString" }, "coordinates": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/position" } } } }
    },
    "polygon": {
      "type": "object", "required": ["type", "coordinates"],
      "properties": { "type": { "const": "Polygon" }, "coordinates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/linearRing" } } }
    },
    "multiPolygon": {
      "type": "object", "required": ["type", "coordinates"],
      "properties": { "type": { "const": "MultiPolygon" }, "coordinates": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/linearRing" } } } }
    },
    "source": {
      "type": "object", "required": ["app", "app_version", "record_id"],
      "properties": {
        "app": { "type": "string", "minLength": 1 },
        "app_version": { "type": "string" },
        "record_id": { "type": "string", "minLength": 1 }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" },
      "additionalProperties": { "type": "object" }
    },
    "mediaRef": { "type": "string", "pattern": "^media/[^/]+$" },
    "envelope": {
      "type": "object",
      "required": ["id", "created_at", "updated_at", "source", "visibility"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" },
        "source": { "$ref": "#/$defs/source" },
        "visibility": { "enum": ["private", "shared"] },
        "notes": { "type": "string" },
        "media": { "type": "array", "items": { "$ref": "#/$defs/mediaRef" } },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "moon": {
      "type": "object",
      "properties": {
        "phase": { "type": "string" },
        "illumination_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "age_days": { "type": "number", "minimum": 0, "maximum": 30 },
        "is_major_period": { "type": "boolean" },
        "is_minor_period": { "type": "boolean" }
      }
    },
    "weather": {
      "type": "object",
      "properties": {
        "temperature_c": { "type": "number" },
        "humidity_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "pressure_hpa": { "type": "number", "minimum": 0 },
        "pressure_trend": { "enum": ["rising", "steady", "falling"] },
        "wind_speed_mps": { "type": "number", "minimum": 0 },
        "wind_direction_deg": { "type": "number", "minimum": 0, "maximum": 360 },
        "precipitation_mm": { "type": "number", "minimum": 0 },
        "cloud_cover_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "visibility_m": { "type": "number", "minimum": 0 },
        "condition_code": { "type": "integer", "minimum": 0, "maximum": 99 },
        "moon": { "$ref": "#/$defs/moon" },
        "captured_at": { "$ref": "#/$defs/timestamp" },
        "provider": { "type": "string" }
      }
    },
    "measurement": {
      "type": "object", "required": ["name", "value", "unit"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": ["number", "string"] },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "score": {
      "type": "object", "required": ["system", "method"],
      "properties": {
        "system": { "enum": ["boone_crockett", "pope_young", "sci", "buckmasters", "other"] },
        "system_text": { "type": "string", "minLength": 1 },
        "gross": { "type": "number" },
        "net": { "type": "number" },
        "method": { "enum": ["measured", "estimated", "ai"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "scored_at": { "$ref": "#/$defs/timestamp" }
      },
      "if": { "properties": { "system": { "const": "other" } }, "required": ["system"] },
      "then": { "required": ["system_text"] }
    }
  }
}
