{
  "name": "@openhuntdata/validator",
  "version": "1.0.0",
  "description": "Validate Open Hunt Data (.ohd) bundles",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/openhuntdata/spec", "directory": "packages/validator" },
  "type": "module",
